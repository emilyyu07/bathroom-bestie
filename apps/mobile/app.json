{
  "expo": {
    "name": "BathroomBestie",
    "slug": "bathroombestie",
    "version": "0.0.0",
    "platforms": ["android"],
    "android": {
      "package": "app.bathroombestie.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      ["expo-location", { "isAndroidBackgroundLocationEnabled": true }],
      "expo-notifications"
    ]
  }
}
