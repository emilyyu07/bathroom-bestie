{
  "name": "bathroombestie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "pnpm --filter @bathroombestie/sim exec tsx src/cli.ts",
    "migrate": "pnpm --filter @bathroombestie/api migrate",
    "api": "pnpm --filter @bathroombestie/api dev",
    "db:up": "docker compose up -d --wait db",
    "test:db": "DATABASE_URL_TEST=${DATABASE_URL_TEST:-postgres://bathroombestie:bathroombestie@localhost:5432/bathroombestie_test} vitest run apps/api/test/pg.integration.test.ts",
    "test:gemini": "GEMINI_LIVE=1 node --env-file=.env node_modules/vitest/vitest.mjs run apps/api/test/gemini.live.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
